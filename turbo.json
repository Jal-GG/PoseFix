{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "push": {
      "cache": false,
      "dependsOn": ["^generate"]
    },
    "migrate": {
      "cache": false,
      "dependsOn": ["^generate"]
    },
    "studio": {
      "cache": false,
      "persistent": true
    }
  }
}
